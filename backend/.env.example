# MySQL metastore
MYSQL_HOST=expenseanalyzer.mysql.pythonanywhere-services.com
MYSQL_USER=expenseanalyzer
MYSQL_PASSWORD=
MYSQL_DB=expenseanalyzer$metastore

# AWS DynamoDB
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
DB_REGION=ap-south-1
TABLE_NAME=expense_table

# Session cookie (set a strong random value in production)
SESSION_SECRET_KEY=change-me-to-a-long-random-string
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_NAME=expense_session
SESSION_HTTPS_ONLY=false
SESSION_SAME_SITE=lax

# CORS (comma-separated; required if frontend origin differs)
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
