# SQLite metastore (primary)
SQLITE_DB_PATH=data/metastore.db

# MySQL metastore (backup target)
MYSQL_HOST=expenseanalyzer.mysql.pythonanywhere-services.com
MYSQL_USER=expenseanalyzer
MYSQL_PASSWORD=
MYSQL_DB=expenseanalyzer$metastore
MYSQL_BACKUP_ENABLED=false
MYSQL_BACKUP_INTERVAL_SECONDS=3600

# AWS DynamoDB
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
DB_REGION=ap-south-1
TABLE_NAME=expense_table

# Session
SESSION_SECRET_KEY=dev-session-secret-change-me

# API
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
